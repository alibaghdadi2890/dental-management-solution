# Copy to apps/api/.env for local development. Values match docker-compose.yml.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Runtime role (RLS applies), BYPASSRLS role (withoutTenant only), and schema owner (migrations).
DATABASE_URL=postgres://dcm_app:dcm_app@localhost:55432/dcm
DATABASE_ADMIN_URL=postgres://dcm_admin:dcm_admin@localhost:55432/dcm
DATABASE_MIGRATION_URL=postgres://dcm_owner:dcm_owner@localhost:55432/dcm

REDIS_URL=redis://localhost:56379

S3_ENDPOINT=http://localhost:58333
S3_REGION=us-east-1
S3_BUCKET=dcm-local
S3_ACCESS_KEY_ID=dcm-local
S3_SECRET_ACCESS_KEY=dcm-local-secret
S3_FORCE_PATH_STYLE=true

# Standard OpenTelemetry variables; point OTEL_EXPORTER_OTLP_ENDPOINT at a collector to enable.
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=dcm-api
