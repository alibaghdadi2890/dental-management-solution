# The box, as the shared ERP scripts in mhdb-studio/infra/erp see it (park, start, find-host).
# Keep in step with mhdb-studio/infra/erp/dcm/main.tf. DOMAIN: the app's address, a proxied
# Cloudflare record (TLS at the edge); WEB_ACCESS=cloudflare keeps :80 open to Cloudflare's ranges
# only (start.sh reapplies it). After a Start, repoint DOMAIN's A record at the new IP.
# WORKFLOW_REPO: the studio's repo runs the Shut down / Start workflows (this repo cannot use the
# studio's private actions).
PROJECT=dcm
ENVIRONMENT=dev
INSTANCE=dcm-dev
STATIC_IP=dcm-dev-ip
KEY_PAIR=dcm-dev-deploy
ZONE=eu-west-3a
BUNDLE=micro_3_0
APP_DIR=/opt/dcm
HEALTH_URL=http://localhost/health/ready
REPO=alibaghdadi2890/dental-management-solution
WEB_ACCESS=cloudflare
DOMAIN=dental.mahdibaghdadi.com
WORKFLOW_REPO=mahdibaghdadi/mhdb-studio
