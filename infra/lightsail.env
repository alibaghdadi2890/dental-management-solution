# The box, as the shared ERP scripts in mhdb-studio/infra/erp see it (park, start, find-host).
# Keep in step with mhdb-studio/infra/erp/dcm/main.tf. WEB_ACCESS=public: no domain, :80 open to
# everyone (the module's public_web). WORKFLOW_REPO: the studio's repo runs the Shut down / Start
# workflows (this repo cannot use the studio's private actions); the box adopts a new IP at boot.
PROJECT=dcm
ENVIRONMENT=dev
INSTANCE=dcm-dev
STATIC_IP=dcm-dev-ip
KEY_PAIR=dcm-dev-deploy
ZONE=eu-west-3a
BUNDLE=nano_3_0
APP_DIR=/opt/dcm
HEALTH_URL=http://localhost/health/ready
REPO=alibaghdadi2890/dental-management-solution
WEB_ACCESS=public
WORKFLOW_REPO=mahdibaghdadi/mhdb-studio
